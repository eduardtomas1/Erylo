root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,sh}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown may use two trailing spaces for an intentional hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
